# Environment Configuration for Student Job Portal
# If AWS variables are left empty, the application runs locally (SQLite + local files).
# Once deployed to AWS, fill in your RDS and S3 details!

# --- AWS S3 (Practical 3) ---
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
# When running on EC2 with IAM Role (Practical 8), leave keys blank:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AWS RDS MySQL (Practical 7) ---
# Set USE_AWS_RDS=True to connect to your RDS MySQL instance
USE_AWS_RDS=False
RDS_DB_NAME=jobportal
RDS_USER=admin
RDS_PASSWORD=test1234
RDS_HOST=
RDS_PORT=3306
